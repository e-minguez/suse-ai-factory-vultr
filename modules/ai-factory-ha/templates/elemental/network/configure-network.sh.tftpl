#!/usr/bin/env bash
# elemental's network/configure-network.sh hook, run in the initrd on first
# boot. Hostname and RKE2 role are NOT set here -- they come from each node's
# Ignition user_data (locals.tf's node_runtime_ignition); metadata's hostname
# is used only for the nmstate document's filename and for logging.
#
# The script discovers the SHAPE of the machine -- how many NICs, which faces
# the internet -- and, for a dual-NIC node, reads its VPC address straight
# from Vultr's own instance metadata instead of consulting a baked table (see
# vpc_interface_yaml() below; see locals.tf and the module README's "VPC
# addresses" section for the reasoning).
# A single-NIC (vpc_only) node gets nothing applied at all, see "WHY A
# vpc_only NIC IS LEFT ALONE" below.
#
# The shape is decided by the physical NIC count in /sys/class/net, NOT by
# whether metadata serves /v1/interfaces/ -- see the long comment above the
# branch itself for why that distinction matters.
#
# Restricted environment: curl and mkdir are available (upstream examples call
# both), but tr/basename/dirname/mktemp/jq/python3 are not used -- bash builtins
# only, to stay inside the toolbox the docs demonstrate.
set -euo pipefail

METADATA_BASE="http://169.254.169.254/v1"

log() {
  echo "[configure-network] $*"
}

die() {
  log "ERROR: $*"
  exit 1
}

fetch() {
  # $1 = path under $METADATA_BASE, e.g. "hostname" or "interfaces/0/mac".
  # Callers that treat absence as normal must add "|| true": in the initrd,
  # metadata is not reachable over a VPC NIC until its DHCP completes, so any
  # of these can 404 or hang transiently here. That is a TIMING property of
  # the initrd, not a property of vpc_only nodes -- the tree is served fine
  # once such a node is up.
  curl -fsS "$METADATA_BASE/$1"
}

# MAC -> kernel interface name, by scanning /sys/class/net/*/address using
# only bash builtins (no tr/basename/dirname). Echoes the name and returns 0
# on match, returns 1 with nothing echoed otherwise -- caller is expected to
# skip that MAC with a log line.
resolve_ifname() {
  local want=$${1,,} sys_path sys_mac ifname
  for sys_path in /sys/class/net/*/address; do
    [ -e "$sys_path" ] || continue
    read -r sys_mac < "$sys_path"
    sys_mac=$${sys_mac,,}
    if [ "$sys_mac" = "$want" ]; then
      ifname=$${sys_path%/address}
      ifname=$${ifname##*/}
      printf '%s' "$ifname"
      return 0
    fi
  done
  return 1
}

read_mac() {
  # $1 = kernel interface name
  local mac
  read -r mac < "/sys/class/net/$1/address"
  printf '%s' "$mac"
}

# A dotted quad with every octet in range. metadata's ipv4/address is NOT
# always an address: a DHCP-configured VPC attachment reports the literal
# string "dhcp". Feeding that to nmstate would
# produce a profile with a garbage address on the one NIC this script must
# never re-profile -- see "WHY A vpc_only NIC IS LEFT ALONE" below.
is_ipv4() {
  local candidate=$1 octet
  [[ $candidate =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]] || return 1
  local IFS=.
  for octet in $candidate; do
    [ "$((10#$octet))" -le 255 ] || return 1
  done
  return 0
}

# One nmstate entry for a VPC NIC: static, address from Vultr's own instance
# metadata (see the classification loop below, which fetches it), MTU
# ${vpc_mtu}, no DHCP, and no default route -- routing is decided once below,
# after classification.
#
# Only for a node that ALSO has a public NIC (today: GPU bare metal). Such a
# node is never a load balancer backend, so nothing on Vultr's side needs to
# agree with the address, and the fabric does not enforce it. A vpc_only node
# must not use this -- see below.
vpc_interface_yaml() {
  # $1 = kernel interface name, $2 = MAC, $3 = VPC address (from metadata)
  printf '%s' "
  - name: $1
    type: ethernet
    state: up
    mac-address: $2
    mtu: ${vpc_mtu}
    ipv4:
      enabled: true
      dhcp: false
      address:
        - ip: $3
          prefix-length: ${vpc_prefix}
    ipv6:
      enabled: false"
}

# WHY A vpc_only NIC IS LEFT ALONE
# Vultr grants a VPC attachment's real registered address to exactly ONE DHCP
# transaction, ever -- whichever comes first. That is always NetworkManager's
# own ephemeral "Wired Connection" profile, activating on carrier-up before
# this script runs. `nmc apply` with ANY document for that interface -- even
# one asking for the same "dhcp: true" -- makes NetworkManager build a distinct
# profile and switch to it, which is a fresh DISCOVER rather than a renewal.
# That second transaction permanently gets a CGNAT-range fallback address
# (100.64.0.0/24), sticky across reconnect and reboot. dhcp-send-hostname and
# client-id have both been ruled out as causes.
#
# So there is no vpc_interface_dhcp_yaml(): this script creates no
# NetworkManager profile for a vpc_only NIC at all. The MTU/IPv6 tweaks the
# vpc_dhcp branch does further down bypass NetworkManager for the same reason.

log "fetching hostname from metadata"
node_hostname=$(fetch hostname || true)
if [ -z "$node_hostname" ] && [ -r /etc/hostname ]; then
  # /etc/hostname comes from Ignition user_data, but whether Ignition has run
  # by the time this initrd hook does isn't pinned down anywhere -- so metadata
  # stays primary. The fallback matters because metadata may not be reachable
  # at all this early on a vpc_only node, whose only route to 169.254.169.254
  # is the VPC NIC that is still DHCPing.
  read -r node_hostname < /etc/hostname || true
  log "metadata gave no hostname, fell back to /etc/hostname"
fi
[ -n "$node_hostname" ] || die "no hostname from metadata or /etc/hostname, refusing to continue"
log "hostname is $node_hostname"

# Real NIC count from /sys. Two jobs: it decides the node's shape (the branch
# below), and on the dual-NIC path it also detects a metadata listing that is
# present but INCOMPLETE -- on bare metal, /v1/interfaces/ can lag several
# seconds behind the VPC NIC actually being live, and an
# unretried fetch landing in that window misclassifies a dual-NIC node.
physical_ifaces=0
for sys_path in /sys/class/net/*/address; do
  ifname=$${sys_path%/address}
  ifname=$${ifname##*/}
  # A real NIC has a backing device; skips lo and virtual interfaces.
  [ -e "/sys/class/net/$ifname/device" ] || continue
  physical_ifaces=$((physical_ifaces + 1))
done
log "found $physical_ifaces physical NIC(s) via /sys/class/net"

# Set only on the vpc_only/single-NIC path, where the NIC keeps whatever
# NetworkManager's own default profile gave it. See "WHY A vpc_only NIC IS LEFT
# ALONE" above.
vpc_dhcp=""

retry_attempt=0
max_retry_attempts=10
retry_sleep_seconds=3

public_ifname=""
vpc_ifname=""
vpc_address=""
interfaces_yaml=""

# THE SHAPE SIGNAL IS THE NIC COUNT, NOT METADATA.
#
# Branching on whether /v1/interfaces/ answers looks tempting, on the belief
# that it 404s on a vpc_only instance. It does 404 here, in the initrd -- but
# only because metadata is not yet reachable over a VPC NIC whose DHCP has not
# completed. Once the node is up the tree is served perfectly well, with one
# entry whose ipv4/address is the literal string "dhcp". So that rule is a
# race: any boot where DHCP finishes before this hook runs takes the dual-NIC
# path on a vpc_only node and hands nmc a profile for the one NIC that must
# never get a second DHCP transaction.
#
# $physical_ifaces is read from /sys above: local, always available, and true
# regardless of what metadata is doing.
if [ "$physical_ifaces" -le 1 ]; then
  log "single physical NIC -- treating this as a vpc_only node, metadata not consulted"

  candidates=()
  for sys_path in /sys/class/net/*/address; do
    ifname=$${sys_path%/address}
    ifname=$${ifname##*/}
    [ -e "/sys/class/net/$ifname/device" ] || continue
    candidates+=("$ifname")
  done

  [ "$${#candidates[@]}" -eq 1 ] || die "expected exactly one physical NIC on a vpc_only node, found $${#candidates[@]}: $${candidates[*]:-none}"

  vpc_ifname=$${candidates[0]}
  vpc_dhcp=true
  # No nmstate entry at all: creating any NetworkManager profile for this NIC
  # is itself the mistake. See "WHY A vpc_only NIC IS LEFT ALONE" above.
  log "single NIC $vpc_ifname is the VPC NIC -- leaving NetworkManager's own existing profile for it untouched"
else
  while :; do
    public_ifname=""
    vpc_ifname=""
    vpc_address=""
    interfaces_yaml=""

    iface_listing=$(fetch "interfaces/" || true)

    if [ -z "$iface_listing" ]; then
      # A multi-NIC node with no metadata at all is either the known lag or a
      # real fault; retry, then fail loudly rather than guessing a shape.
      [ "$retry_attempt" -lt "$max_retry_attempts" ] ||
        die "no interface listing in metadata after $retry_attempt retries on a node with $physical_ifaces physical NICs"
      retry_attempt=$((retry_attempt + 1))
      log "no interface listing yet -- retrying in $${retry_sleep_seconds}s (attempt $retry_attempt/$max_retry_attempts)"
      sleep "$retry_sleep_seconds"
      continue
    fi

    listed_ifaces=0
    for entry in $iface_listing; do
      listed_ifaces=$((listed_ifaces + 1))
    done

    if [ "$listed_ifaces" -lt "$physical_ifaces" ] && [ "$retry_attempt" -lt "$max_retry_attempts" ]; then
      retry_attempt=$((retry_attempt + 1))
      log "metadata lists only $listed_ifaces of $physical_ifaces physical NIC(s) -- retrying in $${retry_sleep_seconds}s (attempt $retry_attempt/$max_retry_attempts)"
      sleep "$retry_sleep_seconds"
      continue
    fi

    log "metadata lists interfaces -- classifying them by gateway"

    for entry in $iface_listing; do
      n=$${entry%/}
      [ -n "$n" ] || continue

      mac=$(fetch "interfaces/$n/mac")
      net_type=$(fetch "interfaces/$n/network-type" || true)
      gateway=$(fetch "interfaces/$n/ipv4/gateway" || true)
      log "interface $n: mac=$mac network-type='$net_type' gateway='$gateway'"

      if ! ifname=$(resolve_ifname "$mac"); then
        log "no kernel interface matches MAC $mac (metadata interface $n), skipping it"
        continue
      fi
      log "interface $n ($mac) resolved to kernel interface $ifname"

      # A non-empty ipv4/gateway is what distinguishes the public NIC; the VPC
      # hands out no gateway. network-type only corroborates -- the gateway wins
      # on disagreement, since trusting a wrong network-type yields a node with
      # no default route and no DNS.
      if [ -n "$gateway" ]; then
        [ "$net_type" = "public" ] || log "interface $n: has a gateway but network-type says '$net_type' -- trusting the gateway, treating it as public"
        public_ifname=$ifname
        interfaces_yaml="$interfaces_yaml
  - name: $ifname
    type: ethernet
    state: up
    mac-address: $mac
    ipv4:
      enabled: true
      dhcp: true
    ipv6:
      enabled: false"
      else
        [ "$net_type" = "public" ] && log "interface $n: network-type says 'public' but has no gateway -- trusting the empty gateway, treating it as private"
        if [ -n "$vpc_ifname" ]; then
          log "interface $n ($ifname) is a second VPC NIC -- leaving it unconfigured, $vpc_ifname already carries $vpc_address"
          continue
        fi
        address=$(fetch "interfaces/$n/ipv4/address" || true)
        # A missing or unparseable address here is the same loud failure the old
        # table lookup gave for an unrecognised hostname: a NIC classified
        # private with no address to apply is a node this script cannot safely
        # configure, and the retry loop above already covers the known
        # metadata-lag case on bare metal. is_ipv4 rather than -n because
        # metadata answers "dhcp" for a DHCP-configured attachment, and
        # `ip: dhcp` in an nmstate address block is not a config nmc can honour.
        is_ipv4 "$address" || die "interface $n ($ifname) classified private but metadata gave ipv4/address='$address', not an IPv4 address"
        vpc_ifname=$ifname
        vpc_address=$address
        log "interface $n ($ifname) is the VPC NIC, static $vpc_address/${vpc_prefix}, mtu ${vpc_mtu}"
        interfaces_yaml="$interfaces_yaml$(vpc_interface_yaml "$ifname" "$mac" "$vpc_address")"
      fi
    done

    break
  done
fi

[ -n "$vpc_ifname" ] || die "no VPC interface resolved after $retry_attempt retries -- refusing to produce a node that cannot reach the rest of the cluster"

extra_yaml=""

if [ -n "$vpc_dhcp" ]; then
  # With a NAT gateway on this VPC, DHCP already supplies both a default route
  # and working resolvers, so injecting either by hand here is redundant and
  # risks disagreeing with what DHCP handed out.
  log "vpc_only + DHCP -- trusting DHCP for the default route and resolvers too, no manual route/dns added"

  # MTU and IPv6 still need setting, but via paths NetworkManager's state
  # machine never sees, so they cannot count as a competing DHCP transaction.
  ip link set dev "$vpc_ifname" mtu ${vpc_mtu}
  log "set mtu ${vpc_mtu} on $vpc_ifname directly via ip-link (bypassing NetworkManager, deliberately)"

  if [ -w "/proc/sys/net/ipv6/conf/$vpc_ifname/disable_ipv6" ]; then
    echo 1 > "/proc/sys/net/ipv6/conf/$vpc_ifname/disable_ipv6"
    log "disabled IPv6 on $vpc_ifname via sysctl (bypassing NetworkManager, deliberately)"
  else
    log "could not disable IPv6 on $vpc_ifname via sysctl (not writable) -- leaving it as-is, not fatal"
  fi

  # Diagnostic only: RKE2 finds this address itself via the default route.
  # Short wait in case DHCP is still in flight.
  sleep 2
  log "VPC NIC $vpc_ifname current address(es): $(ip -4 -o addr show dev "$vpc_ifname" scope global 2>&1)"
elif [ -z "$public_ifname" ]; then
  # Static VPC NIC with no public NIC: nothing else supplies a default route or
  # DNS. No node type today reaches this branch; kept for a future shape that
  # is statically addressed with no public NIC.
  log "no public interface -- routing default via NAT gateway ${nat_gateway_ip} out $vpc_ifname"
  extra_yaml="
routes:
  config:
    - destination: 0.0.0.0/0
      next-hop-address: ${nat_gateway_ip}
      next-hop-interface: $vpc_ifname
dns-resolver:
  config:
    server:
%{ for server in dns_servers ~}
      - ${server}
%{ endfor ~}"
else
  log "public interface $public_ifname present -- DHCP supplies the default route and resolvers, no static route/dns added"
fi

if [ -z "$interfaces_yaml" ]; then
  # vpc_only node: nothing to hand nmc. An interface-less document would
  # probably be a no-op, but "probably" is not worth invoking the one tool
  # whose side effect on this NIC is what the script exists to avoid.
  log "no interfaces_yaml to apply -- skipping nmc entirely for this node"
else
  # /dev/shm first, and it is not about tmpfs: this hook runs under
  # catalyst-net-initrd-script.service, whose filesystem sandboxing mounts
  # everything read-only except /proc, /sys and /dev -- /run and /var/tmp fail
  # too, despite being tmpfs. elemental stages its own
  # files under /dev/shm/catalyst for the same reason. The others stay as a
  # fallback, each failure logged, for a build without that sandboxing.
  work_dir=""
  for candidate in /dev/shm /run /var/tmp /tmp; do
    if mkdir_err=$(mkdir -p "$candidate/nmc" 2>&1); then
      work_dir="$candidate/nmc"
      break
    fi
    log "candidate directory $candidate/nmc not usable: $mkdir_err"
  done
  [ -n "$work_dir" ] || die "no writable directory among /dev/shm /run /var/tmp /tmp -- nowhere to stage the nmstate document"
  log "staging nmstate config under $work_dir"

  states_dir="$work_dir/desired-states"
  generated_dir="$work_dir/generated"
  mkdir -p "$states_dir" "$generated_dir"
  nmstate_file="$states_dir/$node_hostname.yaml"

  {
    echo "interfaces:$interfaces_yaml"
    if [ -n "$extra_yaml" ]; then
      echo "$extra_yaml"
    fi
  } > "$nmstate_file"

  log "generated nmstate document at $nmstate_file:"
  while IFS= read -r line; do
    log "  $line"
  done < "$nmstate_file"

  log "running: nmc generate --config-dir $states_dir --output-dir $generated_dir"
  nmc generate --config-dir "$states_dir" --output-dir "$generated_dir"

  log "running: nmc apply --config-dir $generated_dir"
  nmc apply --config-dir "$generated_dir"
fi

# A correctly generated profile is not the same as a working NIC. A bare metal
# server can arrive with its VPC switch port unlit: every line above runs
# identically to a working sibling and names the address the API reserved, yet
# the interface stays NO-CARRIER with no address at all. NetworkManager will
# not activate a profile on a link with no carrier, so the node comes up
# reachable on its public NIC and invisible to the cluster.
#
# Nothing here can fix that, and dying would only cost the shell needed to
# diagnose it. But an unqualified "network configuration complete" on a node
# that cannot reach anything sent one person hunting through this script for a
# bug that was never in it, so say it plainly instead.
carrier=""
if [ -r "/sys/class/net/$vpc_ifname/carrier" ]; then
  # EINVAL on an administratively-down interface; absent carrier is not proof
  # of a fault, only "0" is.
  read -r carrier < "/sys/class/net/$vpc_ifname/carrier" || true
fi
if [ "$carrier" = "0" ]; then
  log "WARNING: VPC interface $vpc_ifname reports NO CARRIER -- its switch port is not up."
  log "WARNING: the configuration above is correct and will activate by itself if the link ever comes up."
  log "WARNING: until then this node cannot reach the cluster. This is a link-layer fault, not a"
  log "WARNING: configuration one -- check the VPC attachment in the Vultr API."
fi

log "network configuration complete (hostname is set separately, via Ignition user_data)"
