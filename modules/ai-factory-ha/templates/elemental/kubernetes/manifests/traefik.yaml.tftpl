# RKE2 packages Traefik as a DaemonSet taking hostPort 80/443, so every node it
# lands on answers on all of its own addresses. Three changes from the defaults:
#
#  1. nodeSelector -- unpinned it would also bind 80/443 on the GPU bare metal
#     nodes' PUBLIC NICs, which have no Vultr firewall. The control planes are
#     vpc_only, so there the ports exist only inside the VPC.
#  2. proxyProtocol -- the ingress load balancer has proxy_protocol on
#     (network.tf); without this Traefik reads the PROXY header as request
#     bytes. trustedIPs is the VPC CIDR because the LB dials backends from its
#     own VPC address, which Vultr reports nowhere. This makes the header
#     REQUIRED from inside the VPC, not optional -- hence (3).
#  3. ports.traefik.hostPort -- /ping for the LB's health check, on an
#     entrypoint with no proxy protocol. Not forwarded, and not public.
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: rke2-traefik
  namespace: kube-system
spec:
  valuesContent: |-
    nodeSelector:
      node-role.kubernetes.io/control-plane: "true"
    # Not needed today -- this module taints nothing -- but a DaemonSet pinned
    # to the control plane has no other way to survive someone adding the
    # conventional taints later.
    tolerations:
      - key: node-role.kubernetes.io/control-plane
        operator: Exists
        effect: NoSchedule
      - key: CriticalAddonsOnly
        operator: Exists
    ports:
      traefik:
        hostPort: 8080
      web:
        proxyProtocol:
          trustedIPs:
            - ${vpc_cidr}
      websecure:
        proxyProtocol:
          trustedIPs:
            - ${vpc_cidr}
