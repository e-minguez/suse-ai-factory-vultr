#!/usr/bin/env bash
# Rendered into the jumphost's user_data by cloud-init and run under
# nohup/setsid (see cloud-init.yaml.tftpl) so a build that takes tens of
# minutes never blocks cloud-init itself. Builds the elemental raw image with
# podman and serves it over plain HTTP for a fixed window. It does NOT import
# it: Terraform's vultr_snapshot_from_url (snapshot.tf) does that, so the
# snapshot lives in state and no Vultr API key ever reaches this host.
set -euo pipefail

exec >> "${log_file}" 2>&1

log() {
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $*"
}

SERVER_PID=""
SERVE_DIR="/srv/img/${serve_path}"
FIREWALLD_OPENED=false

# Closes firewalld, stops the server and removes the raw on any exit path,
# so a crash never leaves the image served. The Vultr firewall rule is not
# this script's to close -- it is a Terraform resource (snapshot.tf).
cleanup() {
  status=$?
  if [ "$FIREWALLD_OPENED" = true ]; then
    log "cleanup: closing port 80 in firewalld"
    firewall-cmd --zone=public --remove-port=80/tcp \
      || log "cleanup: firewall-cmd --remove-port failed (continuing)"
  fi
  if [ -n "$SERVER_PID" ]; then
    log "cleanup: stopping http server (pid $SERVER_PID)"
    kill "$SERVER_PID" 2>/dev/null || true
  fi
  rm -f "$SERVE_DIR/${image_file}"
  exit $status
}
trap cleanup EXIT

log "=== image-factory starting ==="

log "step 1/9: refreshing repos and installing podman, python3, curl"
zypper -n --gpg-auto-import-keys refresh \
  || log "zypper refresh reported a non-zero exit, continuing"
# python3, not python3-base: the base-vs-full split of http.server/json has
# moved across openSUSE releases. PyYAML is only used by step 5's override but
# is installed unconditionally, so that path can't fail on a missing module.
zypper -n install podman python3 python3-PyYAML curl \
  || log "zypper install reported a non-zero exit (packages may already be present), continuing"

log "step 2/9: enabling podman.socket"
systemctl enable --now podman.socket

log "step 3/9: opening port 80 in firewalld"
# Two firewalls sit in front of this port and Vultr's fetcher needs both open:
# the cloud firewall group, whose rule Terraform creates alongside this
# instance (snapshot.tf), and firewalld, which Leap 16 ships active.
#
# No --permanent: runtime-only changes apply without a reload, and the EXIT
# trap undoes it.
if command -v firewall-cmd >/dev/null && systemctl is-active --quiet firewalld; then
  firewall-cmd --zone=public --add-port=80/tcp
  FIREWALLD_OPENED=true
else
  log "firewalld not present/active, nothing to open there"
fi

log "step 4/9: pulling ${elemental_image}"
podman pull "${elemental_image}"

log "step 5/9: fetching the release manifest from ${aif_release_manifest_url}"
# Curled rather than embedded in cloud-init: several KB against the 32 KiB
# user_data ceiling, for no benefit -- the jumphost needs network access anyway.
curl -fsS -o "${config_dir}/release_manifest.aif.yaml" "${aif_release_manifest_url}"

# Two independent rewrites of the fetched manifest, in one Python step:
#
#  1. Core platform override (var.core_platform_override). Empty means "not
#     set". When set, the two-level chain is FLATTENED into one local core
#     manifest rather than redirected, because the resolver hard-forces an
#     oci:// prefix onto corePlatform.image -- only the top-level manifestURI
#     takes file://. release.yaml needs no change: the same path now holds a
#     core manifest, and the resolver accepts either kind.
#
#  2. Systemd extension image overrides (var.sysext_image_overrides). The
#     manifest pins each extension's OCI image and release.yaml has no field
#     to override it, so the only place to change it is here.
#
# Either one alone is enough to need the rewrite; with neither, the fetched
# manifest is used byte for byte.
CORE_OS_BASE="${core_os_image_base}"
CORE_OS_ISO="${core_os_image_iso}"
CORE_K8S_VERSION="${core_k8s_version}"
CORE_K8S_IMAGE="${core_k8s_image}"
# Single-quoted: the value is JSON, full of double quotes. Both the keys and
# the values are validated quote-free and whitespace-free in variables.tf.
SYSEXT_OVERRIDES='${sysext_image_overrides_json}'

if [ -z "$CORE_OS_ISO" ] && [ "$SYSEXT_OVERRIDES" = "{}" ]; then
  log "no core platform override and no sysext image overrides -- using the AIF manifest chain unmodified"
  mv "${config_dir}/release_manifest.aif.yaml" "${config_dir}/release_manifest.yaml"
else
  if [ -n "$CORE_OS_ISO" ]; then
    log "core platform override set -- flattening AIF manifest onto OS image $CORE_OS_ISO"
  else
    log "no core platform override -- keeping the AIF manifest chain, rewriting extension images only"
  fi
  [ "$SYSEXT_OVERRIDES" = "{}" ] || log "sysext image overrides: $SYSEXT_OVERRIDES"

  python3 - "${config_dir}" "$CORE_OS_BASE" "$CORE_OS_ISO" \
            "$CORE_K8S_VERSION" "$CORE_K8S_IMAGE" "${cluster_name}" \
            "$SYSEXT_OVERRIDES" <<'PYEOF'
import json, sys, yaml

config_dir, base, iso, kver, kimage, cluster, sysext_json = sys.argv[1:8]
overrides = json.loads(sysext_json)

with open(config_dir + "/release_manifest.aif.yaml") as f:
    aif = yaml.safe_load(f) or {}

components = aif.get("components") or {}

# Rewrite extension images in place, BEFORE the flatten below copies
# components.systemd across, so one edit covers both output shapes.
#
# Unknown names are fatal. A typo here would otherwise override nothing at all
# and leave the build to fail forty minutes later on the node, as a missing
# binary inside a crash-looping pod -- which is exactly how the open-iscsi
# problem presented the first time.
#
# The variable ships a non-empty default, so this can also fire on a manifest
# that simply does not declare the extension rather than on a typo. The message
# names the escape hatch for that case.
if overrides:
    extensions = (components.get("systemd") or {}).get("extensions") or []
    known = {e.get("name") for e in extensions if e.get("name")}
    unknown = sorted(set(overrides) - known)
    if unknown:
        sys.exit(
            "sysext_image_overrides names extension(s) absent from the release "
            "manifest: %s. The manifest declares: %s. Fix the name, or set "
            "sysext_image_overrides = {} to follow this manifest's own pins."
            % (", ".join(unknown), ", ".join(sorted(known)) or "(none)")
        )
    for extension in extensions:
        name = extension.get("name")
        if name in overrides:
            print("overriding extension %s: %s -> %s"
                  % (name, extension.get("image"), overrides[name]))
            extension["image"] = overrides[name]

if iso:
    # schema omitted deliberately: a manifest without one defaults to v0, the
    # only version whose core Components type this script knows how to
    # populate.
    manifest = {
        "metadata": {
            "name": cluster + "-core-platform",
            # v0 requires a version; reuse the AIF manifest's so the generated
            # file still traces back to the chart set it carries.
            "version": str((aif.get("metadata") or {}).get("version", "0.0.0")),
        },
        "components": {
            "operatingSystem": {"image": {"base": base, "iso": iso}},
            "kubernetes": {"version": kver, "image": kimage},
        },
    }

    # Everything the solution manifest contributed beyond corePlatform.image; a
    # v0 core manifest's Components accepts the same systemd/helm types.
    for key in ("systemd", "helm"):
        value = components.get(key)
        if value:
            manifest["components"][key] = value
else:
    # No flatten: hand back the solution manifest as fetched, minus the
    # extension images just rewritten. Comments do not survive the round trip
    # through yaml, which costs nothing -- the resolver never reads them.
    manifest = aif

with open(config_dir + "/release_manifest.yaml", "w") as f:
    yaml.safe_dump(manifest, f, sort_keys=False)
PYEOF
  rm -f "${config_dir}/release_manifest.aif.yaml"
  log "generated release manifest:"
  cat "${config_dir}/release_manifest.yaml"
fi

log "step 6/9: running elemental customize against ${config_dir}"
# No --local and no podman.sock mount: --local expects every OCI image
# elemental3 unpacks at build time -- not just ${elemental_image} -- to already
# be in the local store, erroring "No such image" instead of pulling, and there
# is no confirmed list of which images that covers. The build runs once per
# apply, so --local's faster-repeat-build benefit buys nothing here.
#
# --security-opt label=disable: Leap 16 defaults to SELinux enforcing. The
# container already needs broad access to build a raw disk image.
podman run --rm \
  --security-opt label=disable \
  -v "${config_dir}:/config" \
  "${elemental_image}" customize --type raw

log "step 7/9: locating produced raw image"
RAW_IMAGE=$(ls -t "${config_dir}"/image-*.raw 2>/dev/null | head -n1 || true)
if [ -z "$RAW_IMAGE" ]; then
  log "ERROR: no ${config_dir}/image-*.raw produced by elemental customize"
  exit 1
fi
log "found raw image: $RAW_IMAGE"

log "step 8/9: serving raw image over http"
mkdir -p "$SERVE_DIR"
mv "$RAW_IMAGE" "$SERVE_DIR/${image_file}"
# Apparent size first: that is what the fetcher pulls, and a truncated or empty
# raw is the other way an import fails -- the loopback check below answers 200
# for a zero-byte file just as happily.
log "raw image: $(du -h --apparent-size "$SERVE_DIR/${image_file}" | cut -f1) apparent, $(du -h "$SERVE_DIR/${image_file}" | cut -f1) on disk"
# An empty index.html suppresses http.server's directory listing, which would
# otherwise hand the random path to anyone scanning during the serve window.
: > /srv/img/index.html

python3 -m http.server 80 --bind 0.0.0.0 --directory /srv/img &
SERVER_PID=$!
log "http server started in background, pid $SERVER_PID"
sleep 2

if ! kill -0 "$SERVER_PID" 2>/dev/null; then
  log "ERROR: http server (pid $SERVER_PID) died immediately after starting -- check that python3's http.server module is installed"
  exit 1
fi
if ! curl -fsS -o /dev/null "http://127.0.0.1/${serve_path}/${image_file}"; then
  log "ERROR: http server is running but the raw image is not fetchable at http://127.0.0.1/${serve_path}/${image_file}"
  exit 1
fi
log "http server confirmed serving the raw image"

log "step 9/9: serving for ${serve_seconds}s, then shutting down"
# A fixed window, not "until the import completes": knowing that would take a
# Vultr API key on this host. Terraform's wait-for-image.sh sees the file
# answer and calls create-from-url within one poll interval, so the window
# only has to cover Vultr's fetch. The http server's access log is
# interleaved into this file: a 'GET /${serve_path}/${image_file}' from an
# address other than 127.0.0.1 or the operator's is Vultr's fetcher.
sleep "${serve_seconds}"

log "=== image-factory finished: serve window over, cleanup handled by the EXIT trap ==="
